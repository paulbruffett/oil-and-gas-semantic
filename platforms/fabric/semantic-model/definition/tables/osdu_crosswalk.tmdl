/// Generated ontology knowledge, materialized by sql/08_knowledge_tools.sql for the agent's asset-knowledge
/// tools (catalog theme 8, ADR 0050). No relationships: the tools query it directly.
table osdu_crosswalk

	column record_id
		dataType: string
		summarizeBy: none
		sourceColumn: record_id

	column asset_id
		dataType: string
		summarizeBy: none
		sourceColumn: asset_id

	partition osdu_crosswalk = entity
		mode: directLake
		source
			entityName: osdu_crosswalk
			schemaName: semantic
			expressionSource: DatabaseQuery
