/// Generated ontology knowledge, materialized by sql/08_knowledge_tools.sql for the agent's asset-knowledge
/// tools (catalog theme 8, ADR 0050). No relationships: the tools query it directly.
table asset_hierarchy

	column asset_id
		dataType: string
		summarizeBy: none
		sourceColumn: asset_id

	column asset_class
		dataType: string
		summarizeBy: none
		sourceColumn: asset_class

	column field_id
		dataType: int64
		summarizeBy: none
		sourceColumn: field_id

	partition asset_hierarchy = entity
		mode: directLake
		source
			entityName: asset_hierarchy
			schemaName: semantic
			expressionSource: DatabaseQuery
