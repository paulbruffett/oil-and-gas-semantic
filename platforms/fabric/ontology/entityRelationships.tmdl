/// A well rolls up to the field it produces from (reference LPG IN_FIELD).
entityRelationship 'Well In Field'
	lineageTag: 0f62694e-fd91-58ae-b59d-b2c29f76377f
	fromEntity: Well
	toEntity: Field

	backingConfiguration
		relationship: well_field

/// A well flows to a facility.
entityRelationship 'Well At Facility'
	lineageTag: 61666b5f-1eed-5328-84ed-3335ad75253e
	fromEntity: Well
	toEntity: Facility

	backingConfiguration
		relationship: well_facility

/// A facility belongs to a field.
entityRelationship 'Facility In Field'
	lineageTag: d2375475-924a-5acc-8afb-2623ca200665
	fromEntity: Facility
	toEntity: Field

	backingConfiguration
		relationship: facility_field

entityRelationship 'Well Operated By'
