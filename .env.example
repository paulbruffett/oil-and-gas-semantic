# Environment for the live sections of the primer notebook, the platform scripts and the agents.
# Names only: never put values in the repo. Keep the real values outside it, in files only you can
# read (chmod 600), one per concern, and export them in the shell that needs them:
#
#   set -a
#   source ~/.config/oag/anthropic.env   # Claude
#   source ~/.config/oag/foundry.env     # Fabric custom agent's model
#   source ~/.config/oag/fabric.env      # Fabric item ids
#   set +a
#
# Two runtimes take no variables here:
#   - Snowflake: a `snow` CLI connection (default name `proton`, key-pair auth) in
#     ~/Library/Application Support/snowflake/config.toml; the private key file stays outside the repo.
#   - Azure / Fabric: `az login` (Entra). Scripts use DefaultAzureCredential; nothing is stored.
# Local sections (tables, metrics, ontology, rules, SHACL) need none of this, only `uv sync`.

# --- Claude (~/.config/oag/anthropic.env) ---------------------------------------------------------
ANTHROPIC_API_KEY=                 # the ontology agent (oag_semantic.ontology_agent)
# OAG_ONTOLOGY_AGENT_MODEL=        # optional; default claude-sonnet-5-5

# --- Fabric custom agent's model (~/.config/oag/foundry.env) ---------------------------------------
OAG_FOUNDRY_ENDPOINT=              # https://<resource>.cognitiveservices.azure.com/openai/v1, same Entra tenant as `az login`
# OAG_AGENT_LLM=                   # optional; default gpt-6-luna

# --- Fabric item ids (~/.config/oag/fabric.env) ----------------------------------------------------
# Resolve once with the Fabric REST API (`az rest`, see platforms/fabric/README.md); the Warehouse and
# Lakehouse lookups need the capacity running.
FABRIC_WORKSPACE_ID=               # workspace oag-reference
FABRIC_LAKEHOUSE_ID=               # lakehouse oag_staging (Parquet staging)
FABRIC_SQL_ENDPOINT=               # Warehouse oag_reference: properties.connectionString
FABRIC_WAREHOUSE_ID=               # Warehouse oag_reference
FABRIC_SEMANTIC_MODEL_ID=          # semantic model oag_reference_model
DYLD_LIBRARY_PATH=                 # macOS: /opt/homebrew/opt/openssl@3/lib, for mssql-python
# FABRIC_WAREHOUSE= FABRIC_SEMANTIC_MODEL= FABRIC_ONTOLOGY=   # optional item names, if not the defaults

# --- Fabric agent service principal, governance test only (~/.config/oag/fabric-sp.env) -----------
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_CERTIFICATE_PATH=   # a path to the certificate, never the certificate itself

# --- Optional overrides ----------------------------------------------------------------------------
# OAG_SNOWFLAKE_CONNECTION=proton  # which `snow` connection the Snowflake harnesses use
# OAG_GRAPHDB_URL=http://127.0.0.1:7200
# OAG_DATASET_DIR= OAG_GOLD_DIR=   # default data/frozen and data/frozen/gold
